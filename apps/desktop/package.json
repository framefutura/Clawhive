{
  "name": "@clawhive/desktop",
  "version": "0.1.0",
  "description": "Multi-agent desktop application with AI capabilities",
  "author": "ClawHive Team",
  "private": true,
  "main": "dist/main/index.js",
  "scripts": {
    "preload": "node -e \"const esbuild=require('esbuild');esbuild.build({entryPoints:['src/preload/index.ts'],bundle:true,platform:'node',outfile:'dist/preload/index.js',format:'cjs',external:['electron']}).then(()=>console.log('Preload built as CJS')).catch(()=>process.exit(1))\"",
    "main": "tsc -b config/tsconfig.node.json --force",
    "dev": "vite",
    "build": "npm run preload && npm run main && vite build && electron-builder",
    "build:dir": "npm run preload && npm run main && vite build && electron-builder --dir",
    "build:mac": "npm run preload && npm run main && vite build && electron-builder --mac",
    "build:mac:signed": "cross-env CSC_NAME=\"Developer ID Application: $(whoami)\" pnpm build:mac",
    "preview": "vite preview",
    "test": "vitest run --config config/vitest.config.ts && vitest run --config config/vitest.renderer.config.ts",
    "test:main": "vitest run --config config/vitest.config.ts",
    "test:renderer": "vitest run --config config/vitest.renderer.config.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@electron/notarize": "^2.5.0",
    "electron-updater": "^6.3.9",
    "@fontsource/manrope": "^5.1.0",
    "@notionhq/client": "^5.16.0",
    "@radix-ui/react-dialog": "^1.1.2",
    "@radix-ui/react-dropdown-menu": "^2.1.2",
    "@radix-ui/react-scroll-area": "^1.2.0",
    "@radix-ui/react-select": "^2.1.2",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.1.4",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "cronstrue": "^3.14.0",
    "crypto-js": "^4.2.0",
    "docx": "^9.6.1",
    "dompurify": "^3.3.3",
    "electron-store": "^8.0.2",
    "gray-matter": "^4.0.3",
    "i18next": "^23.16.0",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.12.0",
    "node-cron": "^3.0.3",
    "pdfjs-dist": "^5.6.205",
    "pdfkit": "^0.18.0",
    "playwright-core": "^1.48.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0",
    "react-i18next": "^14.1.0",
    "sql.js": "^1.11.0",
    "tailwind-merge": "^2.5.4",
    "ws": "^8.20.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "@types/crypto-js": "^4.2.2",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.0.0",
    "@types/node-cron": "^3.0.11",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@types/sql.js": "^1.4.9",
    "@types/ws": "^8.5.12",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.6.0",
    "vite": "^8.0.3",
    "vitest": "^3.0.0"
  }
}
